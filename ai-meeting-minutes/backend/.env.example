# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Application Settings
APP_NAME=AI Meeting Minutes System
APP_VERSION=1.0.0
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./meeting_minutes.db

# File Upload Settings
MAX_UPLOAD_SIZE=500000000
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# Zoom Integration (Get from https://marketplace.zoom.us/)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Microsoft Teams Integration (Get from https://portal.azure.com/)
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
